# Zertifikate holt Caddy automatisch bei Let's Encrypt (ohne E-Mail-Adresse).

(sicher) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
}

# Startseite mit Links und Gesundheitsstatus (vom Doktor erzeugt), Passwort
{$DOMAIN} {
	import sicher
	basic_auth {
		{$DASH_BENUTZER} {$DASH_PASS_HASH}
	}
	root * /srv/start
	file_server
}

# Team-Chat (Rocket.Chat hat eine eigene Anmeldung)
chat.{$DOMAIN} {
	import sicher
	reverse_proxy rocketchat:3000 {
		flush_interval -1
		transport http {
			read_timeout 600s
		}
	}
}

# Dashboards und Artefakte der Agenten, nur lesen, Passwort
dash.{$DOMAIN} {
	import sicher
	basic_auth {
		{$DASH_BENUTZER} {$DASH_PASS_HASH}
	}
	reverse_proxy dateien:8080
}

# MietJUMP: eigene Anmeldung mit persoenlichem Zugangs-Token (mj_..., 46 Zeichen), ohne Basic-Auth davor.
# Doppelte Anmeldung verwirrt Chrome: Es traegt das gespeicherte Basic-Auth-Passwort in das Tokenfeld
# ein und haelt MietJUMPs 401 bei falschem Token fuer eine neue Basic-Auth-Abfrage (belegt 14.11.2026).
miet.{$DOMAIN} {
	import sicher
	log {
		format filter {
			request>uri query {
				delete t
			}
		}
	}
	reverse_proxy mietjump:8787 {
		flush_interval -1
	}
}
