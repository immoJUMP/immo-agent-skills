</div>
<h2>Team</h2><div class="team">{karten}</div>
<h2>Gesundheit</h2><table>{zeilen or '<tr><td colspan=3>noch kein Check gelaufen</td></tr>'}</table>
<footer>Betrieben mit dem Agenten-Doktor. Bei Problemen in Claude Code: „Doktor, schau dir den Server an“.</footer>
</main></body></html>"""
    ziel = DATEN / "start"  # bewusst NICHT in der WebDAV-Ablage: kein Agent kann die Startseite aendern
    ziel.mkdir(parents=True, exist_ok=True)
    sicher_schreiben(ziel / "index.html", html)


def _cron_jobs(slug: str) -> dict:
    """name -> {id, zeitplan} aus `hermes cron list --all`."""
    p = run(["docker", "exec", "-u", "hermes", f"agent-{slug}", "hermes", "cron", "list", "--all"], check=False, still=True)
    jobs, aktuell = {}, None
    for z in p.stdout.splitlines():
        m = re.match(r"\s*([0-9a-f]{8,})\s+\[", z)
        if m:
            aktuell = {"id": m.group(1)}
            continue
        if aktuell is not None:
            if z.strip().startswith("Name:"):
                aktuell["name"] = z.split(":", 1)[1].strip()
                jobs[aktuell["name"]] = aktuell
            elif z.strip().startswith("Schedule:"):
                aktuell["zeitplan"] = z.split(":", 1)[1].strip()
    return jobs


def routinen_einrichten(slug: str, d: dict) -> list:
    """Routinen aus agent.yaml als Hermes-Cron-Jobs. Quelle der Wahrheit ist agent.yaml:
    fehlende werden angelegt, geaenderte neu angelegt, entfernte geloescht."""
    soll = {f"{slug}-{r['name']}": r for r in (d.get("routinen") or []) if r.get("name") and r.get("zeitplan") and r.get("auftrag")}
    ist = _cron_jobs(slug)
    aus = []
    ziel = "telegram" if d.get("telegram") else "rocketchat"
    stempel_datei = agent_pfade(slug)["hermes"] / ".routinen.json"
    try:
        stempel = json.loads(sicher_lesen(stempel_datei, 100_000)) if stempel_datei.exists() else {}
    except (Fehler, ValueError):
        stempel = {}
    for name, job in ist.items():
        if name.startswith(f"{slug}-") and (name not in soll or stempel.get(name) != _routine_hash(soll[name])):
            run(["docker", "exec", "-u", "hermes", f"agent-{slug}", "hermes", "cron", "remove", job["id"]], check=False, still=True)
            if name not in soll:
                aus.append(f"{name}: entfernt")
    ist = _cron_jobs(slug)
    for name, r in soll.items():
        if name in ist:
            continue
        q = run(["docker", "exec", "-u", "hermes", f"agent-{slug}", "hermes", "cron", "create", r["zeitplan"], r["auftrag"],
                 "--name", name, "--deliver", ziel], check=False, still=True)
        if q.returncode == 0:
            stempel[name] = _routine_hash(r)
            stempel.pop(f"fehler:{name}", None)
            aus.append(f"{name}: angelegt ({r['zeitplan']})")
        else:
            letzter = stempel.get(f"fehler:{name}", 0)
            stempel[f"fehler:{name}"] = time.time()
            if time.time() - letzter > 6 * 3600:  # hoechstens alle 6 Stunden melden
                aus.append(f"{name}: FEHLER {(q.stderr or q.stdout).strip()[-200:]}")
    stempel = {n: h for n, h in stempel.items() if n in soll or (n.startswith("fehler:") and n[7:] in soll)}
    sicher_schreiben(stempel_datei, json.dumps(stempel))
    return aus


def _routine_hash(r: dict) -> str:
    return hashlib.sha256(f"{r.get('zeitplan')}|{r.get('auftrag')}".encode()).hexdigest()[:16]


ZEITPLAENE = {
    # name: (OnCalendar, Befehl, Beschreibung)
    "abgleich": ("*:0/2", "abgleich", "Wissens-Repo, Vorschlaege, Freigaben, Fallbuecher"),
    "check": ("hourly", "check", "Gesundheitscheck (Logbuch nur bei Gelb/Rot)"),
    "reparieren": ("*:05/30", "reparieren --still", "bekannte Fehler selbst beheben"),
    "sichern": ("*-*-* 03:00", "sichern", "naechtliche Sicherung"),
    "agenten-check": ("Sun *-*-* 19:00", "agenten-check", "woechentlicher Agenten-Check"),
    "testfragen": ("*:0/15", "testfragen --offen", "Testfragen nach freigegebenen Aenderungen"),
}


def zeitplaene_einrichten() -> None:
    for name, (wann, befehl, text) in ZEITPLAENE.items():
        Path(f"/etc/systemd/system/doktor-{name}.service").write_text(
            f"[Unit]\nDescription=Agenten-Doktor: {text}\nAfter=docker.service\n\n"
            f"[Service]\nType=oneshot\nExecStart=/usr/local/bin/doktor {befehl}\nNice=10\n")
        Path(f"/etc/systemd/system/doktor-{name}.timer").write_text(
            f"[Unit]\nDescription=Agenten-Doktor: {text}\n\n[Timer]\nOnCalendar={wann}\nPersistent=true\n"
            f"RandomizedDelaySec=20\n\n[Install]\nWantedBy=timers.target\n")
    Path("/etc/systemd/system/doktor-nach-start.service").write_text(
        "[Unit]\nDescription=Agenten-Doktor: Agenten nach dem Hochfahren sauber verbinden\n"
        "After=docker.service network-online.target\nWants=network-online.target\n\n"
        "[Service]\nType=oneshot\nExecStartPre=/bin/sleep 20\nExecStart=/usr/local/bin/doktor nach-start\nTimeoutStartSec=900\n\n"
        "[Install]\nWantedBy=multi-user.target\n")
    run(["systemctl", "daemon-reload"])
    run(["systemctl", "enable", "doktor-nach-start.service"], check=False)
    for name in ZEITPLAENE:
        run(["systemctl", "enable", "--now", f"doktor-{name}.timer"], check=False)


def alle_ausrollen(k: dict, defs: dict, erzwingen_rc: bool = False) -> list:
    """Bringt alle Agenten auf den Stand des Wissens-Repos. Idempotent und konvergent:
    fehlende Rocket.Chat-Konten, Zugaenge, Container und Routinen werden angelegt,
    geaenderte Profile neu gerendert und neu gestartet, entfernte Agenten abgebaut."""
    berichte = []
    rci = zustand().get("rocketchat") or {}
    fehlend = [s for s in defs if s not in (rci.get("bots") or {})]
    if erzwingen_rc or fehlend or not rci:
        rci = rocketchat_einrichten(k, defs)
        if fehlend:
            berichte.append("Rocket.Chat-Konto und Raum angelegt fuer: " + ", ".join(fehlend))
    entfernt = [s for s in (rci.get("bots") or {}) if s not in defs]
    if entfernt:
        rc = RocketChat()
        rc.kopf = rc.anmelden(k.get("RC_ADMIN_BENUTZER", "doktor"), geheim()["RC_ADMIN_PASS"])
        z = zustand()
        for s in entfernt:
            bot = z["rocketchat"]["bots"].pop(s)
            rc.api("POST", "users.setActiveStatus", {"userId": bot["user_id"], "activeStatus": False})
            raum = bot.get("raum")
            if raum and raum in z["rocketchat"]["raeume"] and raum not in ("team",) and \
                    not any(b.get("raum") == raum for b in z["rocketchat"]["bots"].values()):
                rc.api("POST", "groups.archive", {"roomId": z["rocketchat"]["raeume"].pop(raum)})
            shutil.rmtree(agent_pfade(s)["basis"], ignore_errors=True)
        zustand_speichern(z)
        rci = z["rocketchat"]
        berichte.append("abgebaut (Konto deaktiviert, Raum archiviert): " + ", ".join(entfernt))
    if any("mietjump" in (d.get("werkzeuge") or []) and not geheim().get(f"MIETJUMP_AGENT_TOKEN_{s.upper().replace('-', '_')}")
           for s, d in defs.items()):
        mietjump_einrichten(k, defs)
    postfach_konfigurieren(defs)
    ohne_konto = [s for s in defs if s not in (rci.get("bots") or {})]
    if dateiablage_konfigurieren({s: d for s, d in defs.items() if s not in ohne_konto}):
        run(["docker", "exec", "agenten-dateien-1", "nginx", "-s", "reload"], check=False)
    if ohne_konto:
        berichte.append("NICHT ausgerollt, Rocket.Chat-Konto fehlt: " + ", ".join(ohne_konto))
        defs = {s: d for s, d in defs.items() if s not in ohne_konto}
    laufend = set(run(["docker", "ps", "--format", "{{.Names}}"], still=True).stdout.split())
    geaendert = []
    for s, d in defs.items():
        try:
            if agent_einrichten(s, d, k, rci):
                geaendert.append(s)
        except Fehler as e:
            berichte.append(f"{s}: Profil nicht gerendert ({str(e)[:200]})")
            logbuch(f"{s}: Profil nicht gerendert", [str(e)[:300]], "fehler")
    compose_agenten_schreiben(defs, k)
    compose("up", "-d", "--remove-orphans", timeout=1800)
    neu = [s for s in defs if f"agent-{s}" not in laufend]
    for s in geaendert:
        if f"agent-{s}" in laufend:
            run(["docker", "restart", f"agent-{s}"], check=False)
    if neu:
        time.sleep(15)
        berichte.append("gestartet: " + ", ".join(f"agent-{s}" for s in neu))
        if k.get("MODELL_ANBIETER") == "codex":
            berichte += [f"{s} braucht noch eine Modellanmeldung (doktor-lokal.sh codex-anmelden <server> {s})" for s in neu]
    if geaendert:
        berichte.append("neu ausgerollt: " + ", ".join(geaendert))
    for s, d in defs.items():
        berichte += routinen_einrichten(s, d)
    startseite_schreiben(k, defs)
    return berichte


def cmd_installieren(a):
    k = konfig()
    if not k.get("DOMAIN"):
        raise Fehler("DOMAIN fehlt in konfig.env.")
    schritte = []
    basis_vorbereiten(k)
    info("Grundordner und Zufallspasswoerter bereit.")
    wissen_vorbereiten(k)
    defs = agenten_definitionen()
    if not defs:
        raise Fehler("Keine Agenten im Wissens-Repo gefunden (agenten/<slug>/agent.yaml).")
    info(f"Agenten im Wissens-Repo: {', '.join(defs)}")
    if k.get("MODELL_ANBIETER") == "meridian" and not geheim().get("CLAUDE_CODE_OAUTH_TOKEN"):
        info("WARNUNG: MODELL_ANBIETER=meridian, aber CLAUDE_CODE_OAUTH_TOKEN fehlt.")
    info("Baue und starte feste Dienste (das dauert beim ersten Mal einige Minuten) ...")
    compose_agenten_schreiben({}, k) if not COMPOSE_AGENTEN.exists() else None
    compose("build", timeout=1800)
    compose("up", "-d", "--remove-orphans", "caddy", "mongo", "rocketchat", "dateien",
            *(["mietjump"] if (BASIS / "mietjump-quelle" / "Dockerfile").exists() else []),
            *(["meridian"] if k.get("MODELL_ANBIETER") == "meridian" else []), timeout=1800)
    schritte.append("feste Dienste gestartet")
    mietjump_einrichten(k, defs)
    schritte += alle_ausrollen(k, defs, erzwingen_rc=True)
    info("Rocket.Chat, Agenten-Container und Routinen eingerichtet: " + ", ".join(f"agent-{s}" for s in defs))
    if k.get("DEMO_DATEN") == "ja":
        mietjump_einrichten(k, defs)
    zeitplaene_einrichten()
    schritte.append("Zeitplaene: Abgleich alle 2 Min., Check stuendlich, Reparatur halbstuendlich, Sicherung 03:00, Agenten-Check sonntags")
    startseite_schreiben(k, defs)
    logbuch("Installation", schritte + [f"Agenten: {', '.join(defs)}", f"Modell: {k.get('MODELL_ANBIETER')} {k.get('MODELL', '')}"], "aufbau")
    logbuch_spiegeln(k)
    info("Fertig. Pruefe jetzt mit: doktor check")


def cmd_abgleich(a):
    k = konfig()
    wissen_holen(k)
    defs = agenten_definitionen()
    berichte = []
    berichte += vorschlaege_abholen(defs, k)
    berichte += freigaben_abholen(defs, k)
    berichte += github_freigaben_abholen(defs, k)
    defs = agenten_definitionen()
    n = fallbuecher_spiegeln(defs, k)
    if n:
        berichte.append(f"{n} Fallbuch-Dateien gespiegelt")
    berichte += alle_ausrollen(k, defs, erzwingen_rc=a.alles)
    if berichte:
        logbuch("Abgleich", berichte, "abgleich")
        logbuch_spiegeln(k)
    for b in berichte:
        info(b)
    if not berichte:
        info("Abgleich: nichts zu tun.")


# ---------------------------------------------------------------- Pruefung

def _container_status() -> dict:
    p = run(["docker", "ps", "-a", "--format", "{{.Names}}\t{{.State}}\t{{.Status}}"], still=True)
    st = {}
    for z in p.stdout.splitlines():
        n, s, t = (z.split("\t") + ["", ""])[:3]
        st[n] = (s, t)
    return st


def pruefungen(mit_modell: bool) -> list:
    k = konfig()
    defs = agenten_definitionen()
    erg = []
    st = _container_status()
    feste = ["agenten-caddy-1", "agenten-mongo-1", "agenten-rocketchat-1", "agenten-dateien-1"]
    if (BASIS / "mietjump-quelle" / "Dockerfile").exists():
        feste.append("agenten-mietjump-1")
    if k.get("MODELL_ANBIETER") == "meridian":
        feste.append("agenten-meridian-1")
    if geheim().get("GMAIL_REFRESH_TOKEN"):
        feste.append("agenten-postfach-1")
    for c in feste + [f"agent-{s}" for s in defs]:
        s, t = st.get(c, ("fehlt", ""))
        if s == "running":
            erg.append((GELB if "unhealthy" in t else GRUEN, c, t))
        else:
            erg.append((ROT, c, f"{s} {t}".strip()))
    # Agenten: Gateway-Prozess und Plattformverbindung
    for s in defs:
        if st.get(f"agent-{s}", ("",))[0] != "running":
            continue
        start = run(["docker", "inspect", "-f", "{{.State.StartedAt}}", f"agent-{s}"], check=False, still=True).stdout.strip()
        p = run(["docker", "logs", "--since", start or "30m", f"agent-{s}"], check=False, still=True)
        logs = (p.stdout + p.stderr)[-20000:]
        # "failed to authenticate" meldet das Plugin auch bei DNS-Fehlern waehrend des Hochfahrens.
        # Ein echtes Anmeldeproblem erkennt man an "rejected with HTTP 401".
        fehler = [m for m in ("rejected with HTTP 401", "token_invalidated", "invalid_grant", "Conflict: terminated by other getUpdates",
                              "weekly limit", "Traceback") if m in logs]
        erg.append((GELB if fehler else GRUEN, f"{s}: Protokoll seit Start", "Auffaellig: " + ", ".join(fehler) if fehler else "keine bekannten Fehlermuster"))
        hp = agent_pfade(s)["hermes"]
        if "mietjump" in (defs[s].get("werkzeuge") or []):
            al = hp / "logs" / "agent.log"
            try:
                roh = sicher_lesen(al, 50_000_000).decode("utf-8", "replace") if al.exists() else ""
            except Fehler:
                roh = ""
            zeilen = [z for z in roh.splitlines()[-4000:] if "MCP: registered" in z]
            if zeilen and " registered 0 tool(s)" in zeilen[-1]:
                erg.append((ROT, f"{s}: MietJUMP-Werkzeuge", "MCP-Verbindung beim Start gescheitert und geparkt (Neustart des Agenten noetig)"))
            elif zeilen:
                erg.append((GRUEN, f"{s}: MietJUMP-Werkzeuge", zeilen[-1].split("MCP:", 1)[-1].strip()[:80]))
        if not (hp / "plugins" / "rocketchat-platform" / "plugin.yaml").exists():
            erg.append((ROT, f"{s}: Rocket.Chat-Plugin", "fehlt im Profil, Agent ist im Chat taub"))
        envd = lies_env(hp / ".env")
        if not envd.get("ROCKETCHAT_ALLOWED_USERS"):
            erg.append((ROT, f"{s}: Allowlist", "ROCKETCHAT_ALLOWED_USERS leer, Agent antwortet niemandem"))
        if defs[s].get("telegram") and not envd.get("TELEGRAM_BOT_TOKEN"):
            erg.append((GELB, f"{s}: Telegram", "kein Bot-Token gesetzt"))
    # Rocket.Chat API
    try:
        s, _ = http_json("GET", f"http://{container_ip('agenten-rocketchat-1')}:3000/api/info", timeout=5)
        erg.append((GRUEN if s == 200 else ROT, "Rocket.Chat API", f"HTTP {s}"))
    except Exception as e:  # noqa: BLE001
        erg.append((ROT, "Rocket.Chat API", str(e)[:120]))
    # MietJUMP
    if "agenten-mietjump-1" in feste:
        try:
            s, _ = http_json("GET", f"http://{container_ip('agenten-mietjump-1')}:8787/gesund", timeout=5)
            erg.append((GRUEN if s == 200 else ROT, "MietJUMP", f"/gesund HTTP {s}"))
        except Exception as e:  # noqa: BLE001
            erg.append((ROT, "MietJUMP", str(e)[:120]))
    if geheim().get("GMAIL_REFRESH_TOKEN"):
        try:
            s_, _ = http_json("GET", f"http://{container_ip('agenten-postfach-1')}:8090/gesund", timeout=5)
            erg.append((GRUEN if s_ == 200 else ROT, "Postfach-Wache", f"HTTP {s_}"))
        except Exception as e:  # noqa: BLE001
            erg.append((ROT, "Postfach-Wache", str(e)[:120]))
    # WebDAV schreiben und lesen
    try:
        ip = container_ip("agenten-dateien-1")
        erster = next(iter(defs), None)
        if not erster:
            raise Fehler("keine Agenten")
        import base64
        req = urllib.request.Request(f"http://{ip}:8081/{erster}/_check/ping.txt", data=f"{time.time()}".encode(), method="PUT")
        req.add_header("Authorization", "Basic " + base64.b64encode(f"{erster}:{webdav_passwort(erster)}".encode()).decode())
        with urllib.request.urlopen(req, timeout=5):
            pass
        with urllib.request.urlopen(f"http://{ip}:8080/{erster}/_check/ping.txt", timeout=5) as r:
            erg.append((GRUEN if r.status == 200 else ROT, "Dashboard-Ablage", "schreiben und lesen ok"))
    except Exception as e:  # noqa: BLE001
        erg.append((ROT, "Dashboard-Ablage", str(e)[:120]))
    # Zertifikate (oeffentlich erreichbar?)
    for h in (k.get("DOMAIN"), f"chat.{k.get('DOMAIN')}"):
        p = run(["bash", "-c", f"echo | timeout 8 openssl s_client -servername {h} -connect 127.0.0.1:443 2>/dev/null | openssl x509 -noout -enddate"], check=False, still=True)
        if p.returncode == 0 and "notAfter" in p.stdout:
            ende = dt.datetime.strptime(p.stdout.strip().split("=", 1)[1], "%b %d %H:%M:%S %Y %Z")
            tage = (ende - dt.datetime.now(dt.timezone.utc).replace(tzinfo=None)).days
            erg.append((GRUEN if tage > 14 else GELB if tage > 3 else ROT, f"Zertifikat {h}", f"noch {tage} Tage"))
        else:
            erg.append((GELB, f"Zertifikat {h}", "noch keins (DNS pruefen, Caddy holt es beim ersten Aufruf)"))
    # Platte, Speicher, Updates, Tailscale, Sicherung
    du = shutil.disk_usage("/")
    frei = du.free / du.total * 100
    erg.append((GRUEN if frei > 20 else GELB if frei > 10 else ROT, "Festplatte", f"{frei:.0f} % frei"))
    mem = Path("/proc/meminfo").read_text()
    verf = int(re.search(r"MemAvailable:\s+(\d+)", mem).group(1)) // 1024
    erg.append((GRUEN if verf > 1500 else GELB if verf > 500 else ROT, "Arbeitsspeicher", f"{verf} MB verfuegbar"))
    if Path("/var/run/reboot-required").exists():
        erg.append((GELB, "Sicherheitsupdates", "Neustart ausstehend (passiert automatisch 04:30)"))
    else:
        erg.append((GRUEN, "Sicherheitsupdates", "automatisch, kein Neustart offen"))
    p = run(["tailscale", "status", "--json"], check=False, still=True)
    try:
        ts = json.loads(p.stdout)
        ok = ts.get("BackendState") == "Running"
        erg.append((GRUEN if ok else GELB, "Tailscale", ts.get("Self", {}).get("DNSName", "") if ok else ts.get("BackendState", "aus")))
    except Exception:  # noqa: BLE001
        erg.append((GELB, "Tailscale", "nicht verbunden"))
    letzte = zustand().get("letzte_sicherung")
    if not letzte:
        erg.append((GELB, "Sicherung", "noch keine Sicherung"))
    else:
        alter = (jetzt() - dt.datetime.fromisoformat(letzte)).total_seconds() / 3600
        erg.append((GRUEN if alter < 30 else GELB if alter < 72 else ROT, "Sicherung", f"zuletzt vor {alter:.0f} Std."))
    if mit_modell:
        for s in defs:
            if st.get(f"agent-{s}", ("",))[0] == "running":
                ok, txt = modell_test(s)
                erg.append((GRUEN if ok else ROT, f"{s}: Modell", txt))
    return erg


def modell_test(slug: str) -> tuple:
    marke = f"OK-{slug.upper()}-{secrets.token_hex(2)}"
    p = run(["docker", "exec", "-u", "hermes", f"agent-{slug}", "hermes", "chat", "-Q", "--max-turns", "1", "--source", "tool",
             "-q", f"Antworte exakt mit {marke} und sonst nichts."], check=False, still=True, timeout=240)
    aus = (p.stdout + p.stderr).strip()
    if marke in aus:
        return True, "echter Modellaufruf ok"
    kurz = aus.splitlines()[-1][:160] if aus else f"Exit {p.returncode}"
    return False, f"keine Antwort: {kurz}"


def cmd_check(a):
    erg = pruefungen(a.modell)
    schlimmst = ROT if any(e[0] == ROT for e in erg) else GELB if any(e[0] == GELB for e in erg) else GRUEN
    if a.json:
        print(json.dumps([{"status": s, "pruefung": n, "detail": d} for s, n, d in erg], ensure_ascii=False, indent=1))
    else:
        breite = max(len(n) for _, n, _ in erg)
        for s, n, d in erg:
            print(f"{AMPEL[s]} {n.ljust(breite)}  {d}")
        print(f"\nGesamt: {AMPEL[schlimmst]} {schlimmst}")
    k = konfig()
    startseite_schreiben(k, agenten_definitionen(), erg)
    z = zustand()
    vorher = z.get("letzter_check") or {}
    nicht_gruen = sorted(n for s, n, _ in erg if s != GRUEN)
    z["letzter_check"] = {"zeit": jetzt().isoformat(), "gesamt": schlimmst, "rot": [n for s, n, _ in erg if s == ROT],
                          "nicht_gruen": nicht_gruen}
    zustand_speichern(z)
    # Ins Logbuch nur bei Aenderung des Befunds (sonst stuendlich dieselbe gelbe Zeile)
    if a.logbuch or (schlimmst != GRUEN and (vorher.get("gesamt") != schlimmst or vorher.get("nicht_gruen") != nicht_gruen)) \
            or (schlimmst == GRUEN and vorher.get("gesamt") not in (None, GRUEN)):
        logbuch(f"Check: {schlimmst}", [f"{AMPEL[s]} {n}: {d}" for s, n, d in erg if s != GRUEN] or ["alles gruen"], "check")
    sys.exit({GRUEN: 0, GELB: 1, ROT: 2}[schlimmst])


def cmd_reparieren(a):
    k = konfig()
    defs = agenten_definitionen()
    massnahmen = []
    erg = pruefungen(False)
    rot = [n for s, n, _ in erg if s == ROT]
    st = _container_status()
    # 1. gestoppte oder fehlende Container
    kaputt = [n for n in rot if n.startswith(("agenten-", "agent-"))]
    if kaputt:
        compose("up", "-d", "--remove-orphans", "caddy", "mongo", "rocketchat", "dateien",
                *(["mietjump"] if (BASIS / "mietjump-quelle" / "Dockerfile").exists() else []), timeout=900)
        for b in alle_ausrollen(k, defs):
            massnahmen.append(b)
        massnahmen.append("gestartet bzw. neu ausgerollt: " + ", ".join(kaputt))
    # 2. Plugin oder Allowlist fehlt
    for slug, d in defs.items():
        if f"{slug}: Rocket.Chat-Plugin" in rot or f"{slug}: Allowlist" in rot:
            agent_einrichten(slug, d, k, zustand().get("rocketchat"))
            # Plugin-Ordner kann gefehlt haben, ohne dass sich der Fingerabdruck aendert: immer neu starten
            run(["docker", "restart", f"agent-{slug}"], check=False)
            massnahmen.append(f"{slug}: Plugin/Allowlist wiederhergestellt, neu gestartet")
    for slug in defs:
        if f"{slug}: MietJUMP-Werkzeuge" in rot:
            if warte_auf_dienste(120):
                run(["docker", "restart", f"agent-{slug}"], check=False)
                massnahmen.append(f"{slug}: MCP-Verbindung zu MietJUMP war geparkt, Agent neu gestartet")
    # 3. Rocket.Chat-Token ungueltig -> neu ausstellen
    for s, n, d in erg:
        if n.endswith("Protokoll seit Start") and "rejected with HTTP 401" in d:
            slug = n.split(":")[0]
            vorher = geheim().get(f"RC_TOKEN_{slug.upper().replace('-', '_')}")
            rocketchat_einrichten(k, defs)  # stellt nur ungueltige Token neu aus
            if geheim().get(f"RC_TOKEN_{slug.upper().replace('-', '_')}") != vorher:
                agent_einrichten(slug, defs[slug], k, zustand().get("rocketchat"))
                run(["docker", "restart", f"agent-{slug}"], check=False)
                massnahmen.append(f"{slug}: Rocket.Chat-Zugangstoken war ungueltig, neu ausgestellt")
        if n.endswith("Protokoll seit Start") and "Conflict: terminated by other getUpdates" in d:
            massnahmen.append(f"{n.split(':')[0]}: Telegram-Bot laeuft doppelt. Pruefen, ob ein anderer Server denselben Bot nutzt (nicht automatisch reparierbar).")
    # 4. Platte voll
    if any(n == "Festplatte" and s != GRUEN for s, n, _ in erg):
        run(["docker", "system", "prune", "-af", "--filter", "until=168h"], check=False)
        run(["journalctl", "--vacuum-size=200M"], check=False)
        massnahmen.append("Docker-Altlasten und Journal aufgeraeumt")
    # 5. Zertifikat fehlt -> Caddy neu laden
    if any(n.startswith("Zertifikat") and s != GRUEN for s, n, _ in erg):
        compose("restart", "caddy", check=False)
        massnahmen.append("Caddy neu gestartet (holt Zertifikate erneut)")
    erg2 = pruefungen(False)
    rot2 = [f"{n}: {d}" for s, n, d in erg2 if s == ROT]
    if getattr(a, "still", False) and not massnahmen and not rot2:
        return
    logbuch("Reparatur", (massnahmen or ["keine automatische Massnahme noetig"]) + ([f"weiter rot: {r}" for r in rot2] or ["danach alles ohne Rot"]), "reparatur")
    logbuch_spiegeln(k)
    for m in massnahmen:
        info(m)
    if rot2:
        print("\nNoch rot (braucht Diagnose durch den Doktor in Claude Code):")
        for r in rot2:
            print(f"🔴 {r}")
        sys.exit(2)
    print("Repariert: kein roter Punkt mehr." if massnahmen else "Nichts zu reparieren.")


def cmd_status(a):
    k = konfig()
    defs = agenten_definitionen()
    st = _container_status()
    print(f"Server {k.get('DOMAIN')}  Modell {k.get('MODELL_ANBIETER')} {k.get('MODELL', '')}")
    for n, (s, t) in sorted(st.items()):
        if n.startswith(("agenten-", "agent-")):
            print(f"  {'🟢' if s == 'running' else '🔴'} {n:28} {t}")
    print(f"Agenten: {', '.join(defs) or 'keine'}")
    d = k.get("DOMAIN")
    print(f"Adressen: https://{d}  https://chat.{d}  https://dash.{d}  https://miet.{d}/anmelden")


def cmd_zugangsdaten(a):
    """Zeigt dem Eigentuemer seine Zugaenge EINMAL im Terminal (nicht im Chat weitergeben)."""
    k, g = konfig(), geheim()
    z = zustand().get("rocketchat", {})
    print(f"Startseite + Dashboards: https://{k['DOMAIN']}  Benutzer {k.get('DASH_BENUTZER', 'team')}  Passwort {g.get('DASH_PASS')}")
    print(f"Team-Chat: https://chat.{k['DOMAIN']}  Benutzer {z.get('eigentuemer_benutzer')}  Passwort {g.get('RC_EIGENTUEMER_PASS')}")
    print(f"MietJUMP: https://miet.{k['DOMAIN']}/anmelden  Schluessel {g.get('MIETJUMP_EIGENTUEMER_TOKEN')}")


def cmd_agenten_check(a):
    k = konfig()
    defs = agenten_definitionen()
    zeilen = [f"# Agenten-Check {jetzt():%d.%m.%Y %H:%M}", "",
              "| Agent | Prompt (Zeichen) | Skills eigene/gesamt | Gedaechtnis | Werkzeuge | Routinen | Fallbuch | Fehler 24h |",
              "|---|---|---|---|---|---|---|---|"]
    hinweise = []
    for slug, d in defs.items():
        if a.slug and slug != a.slug:
            continue
        p = agent_pfade(slug)
        def _laenge(f: Path) -> int:
            try:
                return len(sicher_lesen(f).decode("utf-8", "replace"))
            except (Fehler, OSError):
                return 0
        soul_len = _laenge(p["hermes"] / "SOUL.md")
        eigene = len(list(p["skills"].rglob("SKILL.md")))
        gesamt = len(list((p["hermes"] / "skills").rglob("SKILL.md"))) if (p["hermes"] / "skills").exists() else 0
        mem = p["hermes"] / "memories" / "MEMORY.md"
        mem_len = _laenge(mem)
        fb = len([f for f in p["fallbuch"].glob("*.md") if f.name != "INDEX.md"]) if p["fallbuch"].exists() else 0
        logs = run(["docker", "logs", "--since", "24h", f"agent-{slug}"], check=False, still=True)
        fehler = (logs.stdout + logs.stderr).count("Traceback") + (logs.stdout + logs.stderr).count(" ERROR ")
        routinen = len(d.get("routinen") or [])
        zeilen.append(f"| {slug} | {soul_len} | {eigene}/{gesamt} | {mem_len}/4000 | {', '.join(d.get('werkzeuge') or [])} | {routinen} | {fb} | {fehler} |")
        if soul_len > 12000:
            hinweise.append(f"{slug}: SOUL.md hat {soul_len} Zeichen. Regeln straffen, Wissen in wissen/ auslagern.")
        if mem_len > 3400:
            hinweise.append(f"{slug}: Gedaechtnis zu {mem_len * 100 // 4000} % voll. Dauerhaftes per Vorschlag ins Wissen uebernehmen, Rest entschlacken.")
        if gesamt - eigene > 60:
            hinweise.append(f"{slug}: {gesamt - eigene} mitgelieferte Skills geladen. Ungenutzte in skills.disabled aufnehmen.")
        if fehler > 5:
            hinweise.append(f"{slug}: {fehler} Fehler in 24 Std. Protokoll pruefen (doktor reparieren).")
        try:
            index_text = sicher_lesen(p["fallbuch"] / "INDEX.md").decode("utf-8", "replace")
        except (Fehler, OSError):
            index_text = ""
        if fb and not index_text.count("]("):
            hinweise.append(f"{slug}: Fallbuch-Index ohne Eintraege, obwohl {fb} Faelle existieren.")
    zeilen += ["", "## Hinweise", ""] + ([f"- {h}" for h in hinweise] or ["- keine, alles im Rahmen"])
    text = "\n".join(zeilen) + "\n"
    ziel = WISSEN / "betrieb" / "agenten-check"
    ziel.mkdir(parents=True, exist_ok=True)
    (ziel / "aktuell.md").write_text(text, encoding="utf-8")
    git("checkout", "-q", "main", check=False)
    git("add", "betrieb")
    git("commit", "-q", "-m", "Agenten-Check", check=False)
    hochladen_main(k)
    if "kurt" in defs:
        ausschnitt_rendern("kurt", defs["kurt"])
    logbuch("Agenten-Check", hinweise or ["alles im Rahmen"], "wartung")
    print(text)


def cmd_freigeben(a):
    k = konfig()
    print(pr_freigeben(a.pr, a.von, k, agenten_definitionen()))


def cmd_sichern(a):
    k, g = konfig(), geheim()
    repo = DATEN / "sicherung" / "restic"
    env = dict(os.environ, RESTIC_REPOSITORY=k.get("RESTIC_REPOSITORY", str(repo)), RESTIC_PASSWORD=g["RESTIC_PASSWORD"])
    for key in ("AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY"):
        if g.get(key):
            env[key] = g[key]
    if run(["restic", "cat", "config"], env=env, check=False, still=True).returncode != 0:
        run(["restic", "init"], env=env)
    dump = DATEN / "sicherung" / "dumps"
    if dump.exists():
        shutil.rmtree(dump)  # nie einen alten Dump als neuen ausgeben
    dump.mkdir(parents=True, exist_ok=True)
    probleme = []
    (DATEN / "rocketchat" / "db" / "sicherung.archive").unlink(missing_ok=True)
    q = run(["docker", "exec", "agenten-mongo-1", "mongodump", "--quiet", "--archive=/data/db/sicherung.archive", "--gzip"], check=False)
    if q.returncode == 0 and (DATEN / "rocketchat" / "db" / "sicherung.archive").exists():
        shutil.move(str(DATEN / "rocketchat" / "db" / "sicherung.archive"), dump / "rocketchat.archive.gz")
    else:
        probleme.append("Rocket.Chat-Dump fehlgeschlagen")
    if (BASIS / "mietjump-quelle" / "Dockerfile").exists():
        (DATEN / "mietjump" / "sicherung.db").unlink(missing_ok=True)
        q = run(["docker", "exec", "agenten-mietjump-1", "mietjump", "sicherung", "/app/daten/sicherung.db"], check=False)
        if q.returncode == 0 and (DATEN / "mietjump" / "sicherung.db").exists():
            shutil.move(str(DATEN / "mietjump" / "sicherung.db"), dump / "mietjump.db")
        else:
            probleme.append("MietJUMP-Sicherung fehlgeschlagen")
    p = run(["restic", "backup", "--quiet", "--tag", "doktor", "--exclude", str(DATEN / "rocketchat" / "db"),
             "--exclude", str(repo), str(DATEN), str(BASIS / "konfig.env"), str(GEHEIM_DIR), str(LOGBUCH_DIR)], env=env, check=False)
    run(["restic", "forget", "--quiet", "--keep-daily", "7", "--keep-weekly", "4", "--keep-monthly", "6", "--prune"], env=env, check=False)
    ok = p.returncode == 0 and not probleme
    if p.returncode != 0:
        probleme.append(f"restic: {(p.stderr or '').strip()[-300:]}")
    z = zustand()
    if ok:
        z["letzte_sicherung"] = jetzt().isoformat()
        zustand_speichern(z)
    logbuch("Sicherung " + ("ok" if ok else "FEHLER"), [f"Ziel {env['RESTIC_REPOSITORY']}"] + probleme, "wartung")
    print("Sicherung ok." if ok else "Sicherung fehlgeschlagen: " + "; ".join(probleme))
    sys.exit(0 if ok else 2)


def cmd_aktualisieren(a):
    k = konfig()
    alt = k.get("HERMES_IMAGE", STANDARD_HERMES_IMAGE)
    if not a.hermes:
        print(f"Aktuell: {alt}. Neue Version testen: doktor aktualisieren --hermes vX.Y.Z [--testen-nur]")
        return
    neu = alt.rsplit(":", 1)[0] + ":" + a.hermes
    defs0 = agenten_definitionen()
    ausgang = {s: modell_test(s)[0] for s in defs0}
    if not all(ausgang.values()):
        raise Fehler("Schon vor dem Update antworten nicht alle Agenten (" +
                     ", ".join(s for s, ok in ausgang.items() if not ok) + "). Erst reparieren, dann aktualisieren.")
    info(f"Ziehe {neu} ...")
    run(["docker", "pull", "-q", neu], timeout=1800)
    soll = run(["docker", "run", "--rm", "--entrypoint", "/opt/hermes/.venv/bin/python3", neu, "-c",
                "import sys; sys.path.insert(0,'/opt/hermes'); from hermes_cli.config import DEFAULT_CONFIG; print(DEFAULT_CONFIG['_config_version'])"]).stdout.strip()
    alt_version = k.get("HERMES_CONFIG_VERSION", str(HERMES_CONFIG_VERSION))
    info(f"Neue Config-Version {soll} (bisher {alt_version}).")
    # Probelauf: Kopie des ersten Agenten-Profils mit dem neuen Image, echter Modellaufruf
    defs = agenten_definitionen()
    slug = next(iter(defs))
    probe = DATEN / "probe-update"
    if probe.exists():
        shutil.rmtree(probe)
    shutil.copytree(agent_pfade(slug)["hermes"], probe, symlinks=True, ignore=shutil.ignore_patterns("sessions", "logs", "*.db*"))
    env = lies_env(probe / ".env")
    env = {kk: vv for kk, vv in env.items() if not kk.startswith(("ROCKETCHAT_", "TELEGRAM_"))}  # Probe darf nicht chatten
    schreibe_env(probe / ".env", env)
    cfg = yaml.safe_load((probe / "config.yaml").read_text())
    cfg["plugins"] = {"enabled": [], "disabled": ["rocketchat-platform", "telegram-platform"]}
    (probe / "config.yaml").write_text(yaml.safe_dump(cfg, allow_unicode=True, sort_keys=False))
    besitz_setzen(probe)
    netz = "agenten_agenten"
    marke = f"UPDATE-OK-{secrets.token_hex(2)}"
    p = run(["docker", "run", "--rm", "--network", netz, "-e", f"HERMES_UID={HERMES_UID}", "-e", f"HERMES_GID={HERMES_UID}",
             "-v", f"{probe}:/opt/data", neu, "chat", "-Q", "--max-turns", "1", "--source", "tool", "-q", f"Antworte exakt mit {marke}."],
            check=False, timeout=600)
    ok = marke in (p.stdout + p.stderr)
    shutil.rmtree(probe, ignore_errors=True)
    logbuch(f"Update-Probe Hermes {a.hermes}: {'bestanden' if ok else 'NICHT bestanden'}", [f"Image {neu}", f"Config-Version {soll}"], "update")
    if not ok:
        print("Probelauf fehlgeschlagen. Es bleibt bei " + alt + ".\n" + (p.stdout + p.stderr)[-800:])
        sys.exit(2)
    if a.testen_nur:
        print("Probelauf bestanden. Umstellen mit: doktor aktualisieren --hermes " + a.hermes)
        return
    werte = lies_env(KONFIG)
    werte["HERMES_IMAGE"] = neu
    werte["HERMES_CONFIG_VERSION"] = soll
    schreibe_env(KONFIG, werte)
    k = konfig()
    rci = zustand().get("rocketchat")
    for s, d in defs.items():
        agent_einrichten(s, d, k, rci)
    compose_agenten_schreiben(defs, k)
    compose("up", "-d", timeout=900)
    time.sleep(20)
    fehl = [s for s in defs if not modell_test(s)[0]]
    if fehl:
        werte["HERMES_IMAGE"] = alt
        werte["HERMES_CONFIG_VERSION"] = alt_version
        schreibe_env(KONFIG, werte)
        alle_ausrollen(konfig(), defs)  # Profile mit alter Config-Version neu rendern, alte Images starten
        logbuch(f"Update auf {a.hermes} zurueckgerollt", [f"Modelltest fehlgeschlagen fuer: {', '.join(fehl)}"], "update")
        print("Nach dem Umstellen antworteten nicht alle Agenten. Zurueck auf " + alt)
        sys.exit(2)
    logbuch(f"Hermes auf {a.hermes} aktualisiert", [f"alle {len(defs)} Agenten antworten"], "update")
    print(f"Aktualisiert auf {neu}. Alle Agenten antworten.")


def cmd_vorlage_uebernehmen(a):
    """Nur im Aufbau oder nach Doktor-Update: neue Fassungen der Start-Agenten (Installer) ins Wissens-Repo.
    Ueberschreibt nur Dateien, die seit dem Startstand niemand im Repo geaendert hat, ausser mit --erzwingen."""
    k = konfig()
    quelle = INST / "agenten"
    geaendert, uebersprungen = [], []
    erst = git("rev-list", "--max-parents=0", "HEAD", check=False).stdout.split()
    erster = erst[-1] if erst else None
    for f in quelle.rglob("*"):
        if not f.is_file():
            continue
        rel = "agenten/" + f.relative_to(quelle).as_posix()
        ziel = WISSEN / rel
        neu = f.read_bytes()
        try:
            neu = _platzhalter_text(neu.decode("utf-8"), k).encode("utf-8")
        except UnicodeDecodeError:
            pass
        if ziel.exists() and ziel.read_bytes() == neu:
            continue
        if ziel.exists() and erster and not a.erzwingen:
            # im Repo seit dem Startstand veraendert? Dann nicht ueberschreiben
            log = git("log", "--format=%H", f"{erster}..HEAD", "--", rel, check=False).stdout.split()
            fremd = [h for h in log if "Vorlage" not in git("log", "-1", "--format=%s", h, check=False).stdout]
            if fremd:
                uebersprungen.append(rel)
                continue
        ziel.parent.mkdir(parents=True, exist_ok=True)
        ziel.write_bytes(neu)
        geaendert.append(rel)
    if geaendert:
        _platzhalter_ersetzen(k)
        git("add", "-A")
        git("commit", "-q", "-m", f"Vorlage der Start-Agenten aktualisiert ({len(geaendert)} Dateien, Doktor)")
        hochladen_main(k)
    logbuch("Vorlage der Start-Agenten uebernommen", [f"geaendert: {x}" for x in geaendert] + [f"uebersprungen (im Repo angepasst): {x}" for x in uebersprungen], "aufbau")
    for x in geaendert:
        info(f"aktualisiert: {x}")
    for x in uebersprungen:
        info(f"uebersprungen, im Repo angepasst: {x}")


def warte_auf_dienste(sekunden: int = 300) -> bool:
    """Wartet, bis Rocket.Chat und MietJUMP antworten."""
    ende = time.time() + sekunden
    while time.time() < ende:
        try:
            ok_rc = http_json("GET", f"http://{container_ip('agenten-rocketchat-1')}:3000/api/info", timeout=5)[0] == 200
            ok_mj = (not (BASIS / "mietjump-quelle" / "Dockerfile").exists()) or \
                http_json("GET", f"http://{container_ip('agenten-mietjump-1')}:8787/gesund", timeout=5)[0] == 200
            if ok_rc and ok_mj:
                return True
        except Exception:  # noqa: BLE001
            pass
        time.sleep(5)
    return False


def cmd_nach_start(a):
    """Nach dem Hochfahren: Docker startet alle Container gleichzeitig, Agenten sind schneller als
    Rocket.Chat und MietJUMP und parken dann ihre MCP-Verbindung. Darum warten und Agenten neu starten."""
    defs = agenten_definitionen()
    bereit = warte_auf_dienste(600)
    for s in defs:
        run(["docker", "restart", f"agent-{s}"], check=False)
    logbuch("Start nach Neustart", [f"Dienste bereit: {'ja' if bereit else 'NEIN (10 Min. gewartet)'}",
                                    "Agenten neu gestartet: " + ", ".join(defs)], "wartung")


def testfragen_laden(slug: str) -> list:
    f = WISSEN / "agenten" / slug / "testfragen.yaml"
    if not f.exists():
        return []
    d = yaml.safe_load(f.read_text(encoding="utf-8")) or {}
    liste = d.get("testfragen") if isinstance(d, dict) else d
    return [t for t in (liste or []) if isinstance(t, dict) and t.get("frage") and t.get("erwartet")]


def testfragen_laufen(slug: str) -> tuple:
    """Jede Testfrage an den echten Agenten (mit SOUL und Skills), dann ein getrennter Pruefaufruf ohne
    Agentenregeln: erfuellt die Antwort die erwartete Kernaussage? Ergebnis als Bericht im Wissens-Repo."""
    fragen = testfragen_laden(slug)
    zeilen = [f"# Testfragen {slug} ({jetzt():%d.%m.%Y %H:%M})", "", "| Ergebnis | Frage | Erwartet |", "|---|---|---|"]
    ok_n = 0
    for t in fragen:
        p = run(["docker", "exec", "-u", "hermes", f"agent-{slug}", "hermes", "chat", "-Q", "--max-turns", "6", "--source", "tool",
                 "-q", f"[Testfrage aus dem Lernkreislauf, nichts ausfuehren, nur beschreiben, was du tun wuerdest] {t['frage']}"],
                check=False, still=True, timeout=600)
        antwort = (p.stdout or "").strip()[-4000:]
        urteil = run(["docker", "exec", "-u", "hermes", f"agent-{slug}", "hermes", "chat", "-Q", "--max-turns", "1", "--ignore-rules",
                      "--source", "tool", "-q",
                      "Du bist Pruefer. Erfuellt die ANTWORT die ERWARTETE KERNAUSSAGE inhaltlich? Antworte nur mit JA oder NEIN.\n"
                      f"ERWARTET: {t['erwartet']}\nANTWORT: {antwort}"], check=False, still=True, timeout=300).stdout.strip().upper()
        bestanden = urteil.startswith("JA") or "\nJA" in urteil
        ok_n += bestanden
        zeilen.append(f"| {'bestanden' if bestanden else 'NICHT bestanden'} | {t['frage'][:120]} | {t['erwartet'][:120]} |")
    zeilen += ["", f"{ok_n} von {len(fragen)} bestanden."]
    ziel = WISSEN / "betrieb" / "testfragen" / f"{slug}.md"
    ziel.parent.mkdir(parents=True, exist_ok=True)
    ziel.write_text("\n".join(zeilen) + "\n", encoding="utf-8")
    git("add", "betrieb")
    git("commit", "-q", "-m", f"Testfragen {slug}: {ok_n}/{len(fragen)}", check=False)
    hochladen_main(konfig())
    return ok_n, len(fragen)


def cmd_testfragen(a):
    """Testfragen eines oder aller Agenten. --offen: nur Agenten, deren Definition seit dem letzten Lauf
    per Freigabe geaendert wurde (laeuft per Zeitplan)."""
    defs = agenten_definitionen()
    z = zustand()
    if a.offen:
        ziele = [s for s in z.get("testfragen_offen", []) if s in defs]
    else:
        ziele = [a.slug] if a.slug else list(defs)
    if not ziele:
        return
    ergebnisse = []
    verschoben = []
    for s in ziele:
        if not modell_test(s)[0]:
            verschoben.append(s)
            continue
        ok_n, n = testfragen_laufen(s)
        ergebnisse.append(f"{s}: {ok_n} von {n} Testfragen bestanden")
        if a.offen:
            z = zustand()
            z["testfragen_offen"] = [x for x in z.get("testfragen_offen", []) if x != s]
            zustand_speichern(z)
        if ok_n < n:
            ergebnisse.append(f"{s}: Bericht unter betrieb/testfragen/{s}.md. Letzte Freigabe pruefen oder per Vorschlag nachbessern.")
    if verschoben:
        z = zustand()
        if time.time() - z.get("testfragen_verschoben_gemeldet", 0) > 6 * 3600:
            ergebnisse.append("Modell antwortet nicht, Testfragen verschoben fuer: " + ", ".join(verschoben))
            z["testfragen_verschoben_gemeldet"] = time.time()
            zustand_speichern(z)
    if ergebnisse:
        logbuch("Testfragen", ergebnisse, "test")
        logbuch_spiegeln(konfig())
    for e in ergebnisse:
        print(e)


def cmd_logbuch(a):
    logbuch(a.text, a.zeile or [], a.art)
    logbuch_spiegeln(konfig())
    info("Eintrag gespeichert.")


def cmd_modell_test(a):
    defs = agenten_definitionen()
    ok_alle = True
    for s in defs:
        if a.slug and s != a.slug:
            continue
        ok, txt = modell_test(s)
        ok_alle &= ok
        print(f"{AMPEL[GRUEN if ok else ROT]} {s}: {txt}")
    sys.exit(0 if ok_alle else 2)


def cmd_telegram_koppeln(a):
    """Telegram-Kopplung: Eigentuemer schreibt dem Bot, bekommt einen Code; der Doktor bestaetigt ihn."""
    defs = agenten_definitionen()
    slug = next((s for s, d in defs.items() if d.get("telegram")), None)
    if not slug:
        raise Fehler("Kein Agent mit telegram: true.")
    p = run(["docker", "exec", "-u", "hermes", f"agent-{slug}", "hermes", "pairing", "approve", "telegram", a.code], check=False)
    print((p.stdout + p.stderr).strip())
    lst = run(["docker", "exec", "-u", "hermes", f"agent-{slug}", "hermes", "pairing", "list"], check=False, still=True).stdout
    m = re.search(r"telegram\D+(\d{5,})", lst)
    if m and not konfig().get("EIGENTUEMER_TELEGRAM_ID"):
        w = lies_env(KONFIG)
        w["EIGENTUEMER_TELEGRAM_ID"] = m.group(1)
        schreibe_env(KONFIG, w)
        info(f"Telegram-ID des Eigentuemers gespeichert: {m.group(1)}")
    logbuch("Telegram gekoppelt", [f"Agent {slug}"], "aufbau")


def sperre_holen(warten_s: int = 900):
    """Nur ein veraendernder Doktor-Lauf zur selben Zeit (Zeitplaene und Handaufrufe teilen sich Repo und Container)."""
    import fcntl
    BASIS.mkdir(parents=True, exist_ok=True)
    f = open(BASIS / ".doktor.sperre", "w")
    ende = time.time() + warten_s
    while True:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return f
        except BlockingIOError:
            if time.time() > ende:
                raise Fehler("Ein anderer Doktor-Lauf haelt die Sperre seit 15 Minuten. Bitte spaeter erneut.")
            time.sleep(2)


OHNE_SPERRE = {"status", "zugangsdaten", "geheimnis-setzen"}


def main():
    ap = argparse.ArgumentParser(prog="doktor", description="Betrieb des Agenten-Servers")
    sub = ap.add_subparsers(dest="befehl", required=True)
    sub.add_parser("installieren").set_defaults(f=cmd_installieren)
    s = sub.add_parser("abgleich")
    s.add_argument("--alles", action="store_true", help="alle Agenten neu rendern")
    s.set_defaults(f=cmd_abgleich)
    sub.add_parser("status").set_defaults(f=cmd_status)
    s = sub.add_parser("check")
    s.add_argument("--json", action="store_true")
    s.add_argument("--modell", action="store_true", help="zusaetzlich echter Modellaufruf je Agent")
    s.add_argument("--logbuch", action="store_true", help="auch gruene Ergebnisse protokollieren")
    s.set_defaults(f=cmd_check)
    s = sub.add_parser("reparieren")
    s.add_argument("--still", action="store_true", help="nur protokollieren, wenn etwas getan wurde (fuer den Zeitplan)")
    s.set_defaults(f=cmd_reparieren)
    s = sub.add_parser("agenten-check")
    s.add_argument("slug", nargs="?")
    s.set_defaults(f=cmd_agenten_check)
    s = sub.add_parser("freigeben")
    s.add_argument("pr", type=int)
    s.add_argument("--von", required=True, help="telegram:<id> oder github:<login>")
    s.set_defaults(f=cmd_freigeben)
    s = sub.add_parser("aktualisieren")
    s.add_argument("--hermes")
    s.add_argument("--testen-nur", action="store_true")
    s.set_defaults(f=cmd_aktualisieren)
    sub.add_parser("sichern").set_defaults(f=cmd_sichern)
    s = sub.add_parser("logbuch")
    s.add_argument("text")
    s.add_argument("--zeile", action="append")
    s.add_argument("--art", default="notiz")
    s.set_defaults(f=cmd_logbuch)
    s = sub.add_parser("geheimnis-setzen")
    s.add_argument("schluessel")
    s.set_defaults(f=cmd_geheimnis_setzen)
    s = sub.add_parser("modell-test")
    s.add_argument("slug", nargs="?")
    s.set_defaults(f=cmd_modell_test)
    sub.add_parser("zugangsdaten").set_defaults(f=cmd_zugangsdaten)
    sub.add_parser("nach-start").set_defaults(f=cmd_nach_start)
    s = sub.add_parser("testfragen")
    s.add_argument("slug", nargs="?")
    s.add_argument("--offen", action="store_true", help="nur Agenten mit frisch freigegebenen Aenderungen")
    s.set_defaults(f=cmd_testfragen)
    s = sub.add_parser("vorlage-uebernehmen")
    s.add_argument("--erzwingen", action="store_true")
    s.set_defaults(f=cmd_vorlage_uebernehmen)
    s = sub.add_parser("telegram-koppeln")
    s.add_argument("code")
    s.set_defaults(f=cmd_telegram_koppeln)
    a = ap.parse_args()
    if os.geteuid() != 0:
        print("doktor muss als root laufen.", file=sys.stderr)
        sys.exit(2)
    try:
        sperre = None if a.befehl in OHNE_SPERRE else sperre_holen(60 if a.befehl in ("abgleich", "check", "reparieren") else 900)
        if sperre is not None and (WISSEN / ".git").exists():
            git("checkout", "-q", "-f", "main", check=False)  # nie auf einem Vorschlags-Branch weiterarbeiten
        a.f(a)
    except Fehler as e:
        print(f"FEHLER: {e}", file=sys.stderr)
        logbuch(f"Fehler bei doktor {a.befehl}", [str(e)[:500]], "fehler")
        sys.exit(2)


if __name__ == "__main__":
    main()
