class Fehler(Exception):
    def __init__(self, text, code=EXIT_FEHLER):
        super().__init__(text)
        self.text = text
        self.code = code


class Aufruffehler(Exception):
    pass


# ---------- argparse auf Deutsch ----------

_UEBERSETZUNG = {
    "the following arguments are required: %s": "es fehlen Angaben: %s",
    "unrecognized arguments: %s": "unbekannte Angaben: %s",
    "expected one argument": "erwartet einen Wert",
    "invalid %(type)s value: %(value)r": "ungültiger Wert %(value)r",
    "invalid choice: %(value)r (choose from %(choices)s)":
