class Aufruffehler(Exception):
    pass


class Fehler(Exception):
    pass


# ---------- kleines YAML-Teilformat ----------
# Unterstützt: Abbildungen, Listen (Block und [a, b]), Text in "..." und '...'
# (auch über mehrere Zeilen), Blocktext mit | und >, Kommentare, true/false/null,
# ganze Zahlen. JSON wird ebenfalls gelesen. Anker, Verweise und Typangaben nicht.

class YamlFehler(Exception):
    def __init__(self, zeile, text):
        super().__init__(f"Zeile {zeile}: {text}")
        self.zeile = zeile


_SCHLUESSEL = re.compile(r"""^(?P<k>[A-Za-z_][A-Za-z0-9_-]*|"[^"\n]*"|'[^'\n]*')\s*:(?:\s+(?P<rest>.*))?$""")


def _ist_strich(s):
    return s == "-" or s.startswith("- ")


def _quote_ende(text, start):
    q = text[start]
    i = start + 1
    while i < len(text):
        c = text[i]
        if q == '"' and c == "\\":
            i += 2
            continue
        if c == q:
            if q == "'" and i + 1 < len(text) and text[i + 1] == "'":
                i += 2
                continue
            return i
        i += 1
    return -1


def _ohne_kommentar(zeile):
    """Schneidet einen Kommentar ab. Anführungszeichen zählen nur am Anfang eines Werts."""
    i = 0
    vorher = ""
    while i < len(zeile):
        c = zeile[i]
        if c in "\"'" and vorher in ("", ":", "-", "[", ",", "{"):
            ende = _quote_ende(zeile, i)
            if ende < 0:
                return zeile
            i = ende + 1
            vorher = c
            continue
        if c == "#" and (i == 0 or zeile[i - 1] in " \t"):
            return zeile[:i]
        if not c.isspace():
            vorher = c
        i += 1
    return zeile


_ESCAPES = {"n": "\n", "t": "\t", "r": "\r", '"': '"', "\\": "\\", "/": "/", "0": "\0", " ": " "}


def _unescape(inhalt, q, zeile):
    if q == "'":
        return inhalt.replace("''", "'")
    out = []
    i = 0
    while i < len(inhalt):
        c = inhalt[i]
        if c != "\\":
            out.append(c)
            i += 1
            continue
        n = inhalt[i + 1:i + 2]
        if n in _ESCAPES:
            out.append(_ESCAPES[n])
            i += 2
        elif n in ("x", "u", "U"):
            laenge = {"x": 2, "u": 4, "U": 8}[n]
            hexa = inhalt[i + 2:i + 2 + laenge]
            if len(hexa) != laenge or not re.match(r"^[0-9A-Fa-f]+$", hexa):
                raise YamlFehler(zeile, "ungültige Escape-Sequenz")
            out.append(chr(int(hexa, 16)))
            i += 2 + laenge
        else:
            raise YamlFehler(zeile, f"unbekannte Escape-Sequenz \\{n}")
    return "".join(out)


def _falten(teile):
    out = teile[0].rstrip() if len(teile) > 1 else teile[0]
    leer = 0
    for t in teile[1:]:
        t = t.strip()
        if not t:
            leer += 1
            continue
        out += ("\n" * leer) if leer else " "
        out += t
        leer = 0
    return out


def _einfach(s, zeile):
    if ": " in s or s.endswith(":"):
        raise YamlFehler(zeile, "Text mit ': ' bitte in Anführungszeichen setzen")
    if s[0] in "&*!%@`":
        raise YamlFehler(zeile, "Anker, Verweise und Typangaben werden nicht unterstützt")
    if s in ("~", "null", "Null", "NULL"):
        return None
    if s in ("true", "True", "TRUE"):
        return True
    if s in ("false", "False", "FALSE"):
        return False
    if re.match(r"^[-+]?\d+$", s):
        return int(s)
    return s


class _Yaml:
    def __init__(self, text):
        text = text.replace("\r\n", "\n").replace("\r", "\n")
        if text.startswith("﻿"):
            text = text[1:]
        self.z = text.split("\n")
        self.i = 0

    def laden(self):
        n = self._naechste()
        if n is None:
            return {}
        if n[0] != 0:
            raise YamlFehler(self.i + 1, "die erste Zeile darf nicht eingerückt sein")
        wert = self._knoten(0)
        if self._naechste() is not None:
            raise YamlFehler(self.i + 1, "unerwarteter Inhalt, Einrückung prüfen")
        return wert

    def _naechste(self):
        while self.i < len(self.z):
            roh = self.z[self.i]
            einzug = roh[:len(roh) - len(roh.lstrip())]
            if "\t" in einzug and roh.strip():
                raise YamlFehler(self.i + 1, "Tabulator in der Einrückung, bitte Leerzeichen")
            inhalt = _ohne_kommentar(roh).rstrip()
            s = inhalt.strip()
            if not s or (s == "---" and not einzug):
                self.i += 1
                continue
            return len(inhalt) - len(inhalt.lstrip(" ")), s
        return None

    def _knoten(self, ein):
        n = self._naechste()
        return self._liste(ein) if _ist_strich(n[1]) else self._abbildung(ein)

    def _abbildung(self, ein):
        erg = {}
        while True:
            n = self._naechste()
            if n is None or n[0] < ein:
                return erg
            if n[0] > ein:
                raise YamlFehler(self.i + 1, "unerwartete Einrückung")
            if _ist_strich(n[1]):
                raise YamlFehler(self.i + 1, "Listeneintrag an dieser Stelle nicht erwartet")
            m = _SCHLUESSEL.match(n[1])
            if not m:
                raise YamlFehler(self.i + 1, "erwartet 'schluessel: wert'")
            k = m.group("k")
            if k[0] in "\"'":
                k = k[1:-1]
            zeile = self.i + 1
            if k in erg:
                raise YamlFehler(zeile, f"Schlüssel {k} kommt doppelt vor")
            self.i += 1
            erg[k] = self._wert(m.group("rest") or "", ein, zeile)

    def _liste(self, ein):
        erg = []
        while True:
            n = self._naechste()
            if n is None or n[0] < ein:
                return erg
            if n[0] > ein:
                raise YamlFehler(self.i + 1, "unerwartete Einrückung")
            if not _ist_strich(n[1]):
                return erg
            inhalt = n[1][1:].lstrip(" ")
            versatz = n[0] + len(n[1]) - len(inhalt)
            zeile = self.i + 1
            if not inhalt:
                self.i += 1
                nn = self._naechste()
                erg.append(self._knoten(nn[0]) if nn is not None and nn[0] > ein else None)
            elif _SCHLUESSEL.match(inhalt) or _ist_strich(inhalt):
                self.z[self.i] = " " * versatz + inhalt
                erg.append(self._knoten(versatz))
            else:
                self.i += 1
                erg.append(self._wert(inhalt, ein, zeile))

    def _wert(self, rest, ein, zeile):
        rest = rest.strip()
        if not rest:
            n = self._naechste()
            if n is not None and (n[0] > ein or (n[0] == ein and _ist_strich(n[1]))):
                return self._knoten(n[0])
            return None
        if rest[0] in "|>":
            return self._block(rest, ein, zeile)
        if rest[0] == "[":
            return self._fluss(rest, zeile)
        if rest[0] == "{":
            if rest.replace(" ", "") == "{}":
                return {}
            raise YamlFehler(zeile, "{...} wird nicht unterstützt, bitte eingerückt schreiben")
        if rest[0] in "\"'":
            return self._quoted(rest, zeile)
        return _einfach(rest, zeile)

    def _quoted(self, rest, zeile):
        q = rest[0]
        teile = [rest]
        ende = _quote_ende(rest, 0)
        while ende < 0:
            if self.i >= len(self.z):
                raise YamlFehler(zeile, "Anführungszeichen nicht geschlossen")
            teile.append(self.z[self.i])
            self.i += 1
            ende = _quote_ende("\n".join(teile), 0)
        ganz = "\n".join(teile)
        nach = _ohne_kommentar(ganz[ende + 1:]).strip()
        if nach:
            raise YamlFehler(zeile, "Text nach dem schließenden Anführungszeichen")
        inhalt = ganz[1:ende]
        if "\n" in inhalt:
            inhalt = _falten(inhalt.split("\n"))
        return _unescape(inhalt, q, zeile)

    def _fluss(self, rest, zeile):
        text = rest
        while True:
            tiefe, i, ende = 0, 0, -1
            while i < len(text):
                c = text[i]
                if c in "\"'":
                    e = _quote_ende(text, i)
                    if e < 0:
                        break
                    i = e + 1
                    continue
                if c == "[":
                    tiefe += 1
                elif c == "]":
                    tiefe -= 1
                    if tiefe == 0:
                        ende = i
                        break
                i += 1
            if ende >= 0:
                break
            if self.i >= len(self.z):
                raise YamlFehler(zeile, "Liste mit [ nicht geschlossen")
            text += " " + _ohne_kommentar(self.z[self.i]).strip()
            self.i += 1
        if _ohne_kommentar(text[ende + 1:]).strip():
            raise YamlFehler(zeile, "Text nach dem schließenden ]")
        innen = text[1:ende]
        erg, stueck, i = [], "", 0
        while i < len(innen):
            c = innen[i]
            if c in "\"'" and not stueck.strip():
                e = _quote_ende(innen, i)
                if e < 0:
                    raise YamlFehler(zeile, "Anführungszeichen in der Liste nicht geschlossen")
                stueck += innen[i:e + 1]
                i = e + 1
                continue
            if c in "[]{}":
                raise YamlFehler(zeile, "verschachtelte Listen werden nicht unterstützt")
            if c == ",":
                erg.append(stueck)
                stueck = ""
            else:
                stueck += c
            i += 1
        erg.append(stueck)
        werte = []
        for s in erg:
            s = s.strip()
            if not s:
                continue
            if s[0] in "\"'":
                if _quote_ende(s, 0) != len(s) - 1:
                    raise YamlFehler(zeile, "Text nach dem schließenden Anführungszeichen")
                werte.append(_unescape(s[1:-1], s[0], zeile))
            else:
                werte.append(_einfach(s, zeile))
        return werte

    def _block(self, kopf, ein, zeile):
        art, rest = kopf[0], kopf[1:].strip()
        if rest not in ("", "-", "+"):
            raise YamlFehler(zeile, f"Blockangabe {kopf!r} nicht verstanden, nutze | oder >")
        zeilen, block_ein = [], None
        while self.i < len(self.z):
            roh = self.z[self.i].rstrip()
            if not roh.strip():
                zeilen.append("")
                self.i += 1
                continue
            e = len(roh) - len(roh.lstrip(" "))
            if block_ein is None:
                if e <= ein:
                    break
                block_ein = e
            if e < block_ein:
                break
            zeilen.append(roh[block_ein:])
            self.i += 1
        while zeilen and zeilen[-1] == "":
            zeilen.pop()
        if art == "|":
            text = "\n".join(zeilen)
        else:
            text, leer = "", 0
            for z in zeilen:
                if not z:
                    leer += 1
                    continue
                if text:
                    text += ("\n" * leer) if leer else " "
                text += z
                leer = 0
        if text and rest != "-":
            text += "\n"
        return text


def yaml_laden(text):
    if text.lstrip().startswith("{"):
        try:
            return json.loads(text)
        except ValueError as e:
            raise YamlFehler(getattr(e, "lineno", 1), "JSON nicht lesbar")
    return _Yaml(text).laden()


def datei_laden(pfad):
    with open(pfad, encoding="utf-8") as f:
        wert = yaml_laden(f.read())
    if not isinstance(wert, dict):
        raise YamlFehler(1, "oberste Ebene muss aus 'schluessel: wert' bestehen")
    return wert


# ---------- Pfade und Rechte ----------

def _glob_regex(muster):
    out, i = "", 0
    while i < len(muster):
        if muster.startswith("**/", i):
            out += "(?:.*/)?"
            i += 3
        elif muster.startswith("**", i):
            out += ".*"
            i += 2
        elif muster[i] == "*":
            out += "[^/]*"
            i += 1
        elif muster[i] == "?":
            out += "[^/]"
            i += 1
        else:
            out += re.escape(muster[i])
            i += 1
    return re.compile("^" + out + "$")


def glob_passt(pfad, muster):
    return bool(_glob_regex(muster).match(pfad))


def _pfad_fehler(pfad):
    if pfad.startswith("/") or "\\" in pfad:
        return "muss ein relativer Pfad im Repo sein (ohne führendes /)"
    teile = pfad.split("/")
    if any(t in ("", ".", "..") for t in teile):
        return "enthält leere Teile, '.' oder '..'"
    if ".git" in teile:
        return "darf nicht in .git liegen"
    return None


def kurzname(roh):
    s = roh.lower()
    for alt, neu in (("ä", "ae"), ("ö", "oe"), ("ü", "ue"), ("ß", "ss")):
        s = s.replace(alt, neu)
    s = re.sub(r"[^a-z0-9]+", "-", s).strip("-")[:50].strip("-")
    if not s:
        raise Aufruffehler(f"aus {roh!r} entsteht kein gültiger Ordnername")
    return s


def _basis():
    return os.environ.get("VORSCHLAG_BASIS", BASIS)


def _ordner_finden(roh):
    if os.path.isdir(roh):
        return os.path.abspath(roh)
    kandidat = os.path.join(_basis(), roh)
    if os.path.isdir(kandidat):
        return kandidat
    raise Fehler(f"Vorschlagsordner {roh} nicht gefunden (auch nicht unter {_basis()}).")


def _maskiert(treffer):
    return treffer[:4] + "…"


def _geheimnisse(text, name):
    funde = []
    for art, muster in GEHEIM_MUSTER:
        for m in muster.finditer(text):
            zeile = text.count("\n", 0, m.start()) + 1
            funde.append(f"mögliches Geheimnis ({art}) in {name}, Zeile {zeile}: {_maskiert(m.group(0))}")
    return funde


# ---------- Befehle ----------

def cmd_neu(namen):
    kurz = kurzname("-".join(namen))
    basis = _basis()
    if not os.path.isdir(basis):
        raise Fehler(f"Vorschlagsordner {basis} fehlt. Fall für den Doktor.")
    name = f"{datetime.date.today().isoformat()}-{kurz}"
    ordner = os.path.join(basis, name)
    if os.path.exists(ordner):
        raise Fehler(f"{ordner} gibt es schon. Anderen Kurznamen wählen oder den vorhandenen Vorschlag ergänzen.")
    os.makedirs(os.path.join(ordner, "dateien"))
    with open(os.path.join(ordner, "vorschlag.yaml"), "w", encoding="utf-8") as f:
        f.write(GERUEST)
    slug = os.environ.get("AGENT_SLUG") or "<slug>"
    print(f"Vorschlag angelegt: {ordner}")
    print("Nächste Schritte:")
    print(f"  1. {ordner}/vorschlag.yaml ausfüllen (titel, art, ausloeser, begruendung, testfragen).")
    print(f"  2. Jede geänderte Datei vollständig unter {ordner}/dateien/<pfad-im-repo> ablegen,")
    print(f"     zum Beispiel dateien/agenten/{slug}/wissen/<thema>.md")
    print(f"  3. vorschlag pruefen {name}")
    return 0


def _text_feld(daten, feld, fehler):
    wert = daten.get(feld)
    if not isinstance(wert, str) or not wert.strip():
        fehler.append(f"{feld} fehlt oder ist leer.")
        return ""
    return wert.strip()


def pruefen(ordner):
    """Gibt (fehler, warnungen, hinweise, zusammenfassung) zurück."""
    fehler, warnungen, hinweise = [], [], []
    yaml_pfad = os.path.join(ordner, "vorschlag.yaml")
    if os.path.isfile(os.path.join(ordner, "ergebnis.yaml")):
        try:
            erg = datei_laden(os.path.join(ordner, "ergebnis.yaml"))
            stand = erg.get("status", "unbekannt")
        except (YamlFehler, OSError, UnicodeDecodeError):
            stand = "unlesbar"
        warnungen.append(f"Der Doktor hat diesen Vorschlag schon abgeholt (status: {stand}). "
                         "Änderungen hier wirken nicht mehr, lege einen neuen Vorschlag an.")
    daten, geladen = {}, False
    if os.path.islink(yaml_pfad):
        fehler.append("vorschlag.yaml darf keine Verknüpfung (Symlink) sein.")
    elif not os.path.isfile(yaml_pfad):
        fehler.append("vorschlag.yaml fehlt.")
    else:
        try:
            daten = datei_laden(yaml_pfad)
            geladen = True
        except YamlFehler as e:
            fehler.append(f"vorschlag.yaml ist kein gültiges YAML ({e}).")
        except UnicodeDecodeError:
            fehler.append("vorschlag.yaml ist nicht UTF-8.")
        try:
            with open(yaml_pfad, encoding="utf-8", errors="replace") as f:
                fehler.extend(_geheimnisse(f.read(), "vorschlag.yaml"))
        except OSError as e:
            fehler.append(f"vorschlag.yaml nicht lesbar ({e.strerror}).")

    if geladen:
        _text_feld(daten, "titel", fehler)
        art = daten.get("art")
        if art not in ARTEN:
            fehler.append(f"art muss {', '.join(ARTEN[:-1])} oder {ARTEN[-1]} sein (ist: {art!r}).")
        _text_feld(daten, "ausloeser", fehler)
        _text_feld(daten, "begruendung", fehler)
        fragen = daten.get("testfragen")
        gueltig = 0
        if not isinstance(fragen, list):
            fehler.append("testfragen fehlt (mindestens eine Frage mit erwarteter Kernaussage).")
        else:
            for nr, t in enumerate(fragen, 1):
                if not isinstance(t, dict):
                    fehler.append(f"Testfrage {nr}: braucht frage und erwartet.")
                    continue
                lueckt = [k for k in ("frage", "erwartet") if not isinstance(t.get(k), str) or not t[k].strip()]
                if lueckt:
                    fehler.append(f"Testfrage {nr}: {' und '.join(lueckt)} fehlt.")
                else:
                    gueltig += 1
            if not fragen:
                fehler.append("testfragen ist leer (mindestens eine Frage mit erwarteter Kernaussage).")
        unbekannt = [k for k in daten if k not in FELDER]
        if unbekannt:
            warnungen.append(f"Unbekannte Felder werden ignoriert: {', '.join(map(str, unbekannt))}.")

    loeschen = daten.get("loeschen") if daten else []
    if loeschen is None:
        loeschen = []
    if not isinstance(loeschen, list) or any(not isinstance(x, str) for x in loeschen):
        fehler.append("loeschen muss eine Liste von Pfaden sein, zum Beispiel [] oder [\"a/b.md\"].")
        loeschen = []
    loeschen = [x.strip() for x in loeschen if x.strip()]

    dateien_ordner = os.path.join(ordner, "dateien")
    dateien = []
    if os.path.islink(dateien_ordner):
        fehler.append("dateien/ darf keine Verknüpfung (Symlink) sein.")
    elif os.path.isdir(dateien_ordner):
        for wurzel, ordner_namen, datei_namen in os.walk(dateien_ordner):
            for o in list(ordner_namen):
                if os.path.islink(os.path.join(wurzel, o)):
                    rel = os.path.relpath(os.path.join(wurzel, o), dateien_ordner).replace(os.sep, "/")
                    fehler.append(f"dateien/{rel} ist eine Verknüpfung (Symlink), nicht erlaubt.")
                    ordner_namen.remove(o)
            for d in sorted(datei_namen):
                voll = os.path.join(wurzel, d)
                rel = os.path.relpath(voll, dateien_ordner).replace(os.sep, "/")
                if os.path.islink(voll):
                    fehler.append(f"dateien/{rel} ist eine Verknüpfung (Symlink), nicht erlaubt.")
                    continue
                dateien.append(rel)
                groesse = os.path.getsize(voll)
                if groesse > GROSS:
                    warnungen.append(f"dateien/{rel} ist größer als 1 MB. Gehört das wirklich ins Wissens-Repo?")
                if groesse <= SCAN_GRENZE:
                    with open(voll, "rb") as f:
                        fehler.extend(_geheimnisse(f.read().decode("utf-8", errors="ignore"), f"dateien/{rel}"))
    if not dateien and not loeschen:
        fehler.append("Keine Änderung: dateien/ ist leer und loeschen auch.")

    for pfad in loeschen:
        if pfad in dateien:
            fehler.append(f"{pfad} steht unter loeschen und liegt zugleich in dateien/.")

    alle = [(p, "dateien/" + p) for p in dateien] + [(p, "loeschen: " + p) for p in loeschen]
    for pfad, wo in alle:
        problem = _pfad_fehler(pfad)
        if problem:
            fehler.append(f"{wo} {problem}.")
            continue
        for muster, grund in GESPERRT:
            if glob_passt(pfad, muster):
                fehler.append(f"{wo} ist gesperrt: {grund}.")
                break

    slug = os.environ.get("AGENT_SLUG", "")
    rechte_pfad = os.path.join(os.environ.get("WISSEN_BASIS", WISSEN), "agenten", slug, "rechte.yaml")
    if slug and os.path.isfile(rechte_pfad):
        try:
            rechte = datei_laden(rechte_pfad)
            erlaubt = rechte.get("vorschlagen") or []
            if not isinstance(erlaubt, list):
                raise YamlFehler(1, "vorschlagen ist keine Liste")
            for pfad, wo in alle:
                if not _pfad_fehler(pfad) and not any(glob_passt(pfad, str(m)) for m in erlaubt):
                    fehler.append(f"{wo} liegt außerhalb deiner Vorschlagsrechte "
                                  f"(vorschlagen in agenten/{slug}/rechte.yaml).")
        except (YamlFehler, OSError, UnicodeDecodeError) as e:
            warnungen.append(f"rechte.yaml nicht lesbar ({e}), Rechte nicht lokal geprüft.")
    else:
        hinweise.append("Rechte nicht lokal geprüft (rechte.yaml nicht im Ausschnitt). "
                        "Der Doktor prüft sie beim Abholen.")

    zusammenfassung = (f"{len(dateien)} Datei{'' if len(dateien) == 1 else 'en'}, "
                       f"{len(loeschen)} Löschung{'' if len(loeschen) == 1 else 'en'}")
    return fehler, warnungen, hinweise, zusammenfassung


def cmd_pruefen(roh):
    ordner = _ordner_finden(roh)
    fehler, warnungen, hinweise, zusammenfassung = pruefen(ordner)
    print(f"Prüfe {ordner}")
    for f in fehler:
        print(f"FEHLER: {f}")
    for w in warnungen:
        print(f"WARNUNG: {w}")
    for h in hinweise:
        print(f"Hinweis: {h}")
    if fehler:
        print(f"Ergebnis: {len(fehler)} Fehler. So lehnt der Doktor den Vorschlag ab.")
        if any("Geheimnis" in f for f in fehler):
            print("Geheimnisse gehören nie ins Wissens-Repo. Entferne sie und melde dem Eigentümer, "
                  "dass ein Zugangswert in einer Datei stand.")
        return EXIT_FEHLER
    print(f"Ergebnis: in Ordnung ({zusammenfassung}). Der Doktor holt den Vorschlag beim nächsten Abgleich ab.")
    return 0


def _status_text(ergebnis):
    status = str(ergebnis.get("status") or "unbekannt")
    if status == "pr-erstellt":
        text = f"PR #{ergebnis.get('pr', '?')} erstellt"
        return text + (f": {ergebnis['url']}" if ergebnis.get("url") else ""), "pr"
    if status == "abgelehnt":
        return f"abgelehnt: {ergebnis.get('grund') or 'ohne Grund'}", "abgelehnt"
    zusatz = ergebnis.get("url") or ergebnis.get("grund")
    return status + (f": {zusatz}" if zusatz else ""), "sonst"


def cmd_status():
    basis = _basis()
    if not os.path.isdir(basis):
        raise Fehler(f"Vorschlagsordner {basis} fehlt. Fall für den Doktor.")
    namen = sorted(n for n in os.listdir(basis)
                   if not n.startswith(".") and os.path.isdir(os.path.join(basis, n)))
    if not namen:
        print(f"Keine Vorschläge in {basis}.")
        return 0
    zaehler = {"offen": 0, "pr": 0, "abgelehnt": 0, "sonst": 0}
    for name in namen:
        ordner = os.path.join(basis, name)
        try:
            titel = str(datei_laden(os.path.join(ordner, "vorschlag.yaml")).get("titel") or "(ohne Titel)")
        except (YamlFehler, OSError, UnicodeDecodeError):
            titel = "(vorschlag.yaml fehlt oder ist unlesbar)"
        ergebnis_pfad = os.path.join(ordner, "ergebnis.yaml")
        if os.path.isfile(ergebnis_pfad):
            try:
                text, art = _status_text(datei_laden(ergebnis_pfad))
            except (YamlFehler, OSError, UnicodeDecodeError):
                text, art = "ergebnis.yaml unlesbar", "sonst"
        else:
            text, art = "offen, wartet auf den Doktor", "offen"
        zaehler[art] += 1
        print(f"{name}  [{text}]")
        print(f"    {titel}")
    teile = [f"{zaehler['offen']} offen", f"{zaehler['pr']} mit PR", f"{zaehler['abgelehnt']} abgelehnt"]
    if zaehler["sonst"]:
        teile.append(f"{zaehler['sonst']} sonstige")
    print()
    print(f"{len(namen)} Vorschl{'ag' if len(namen) == 1 else 'äge'}: {', '.join(teile)}.")
    return 0


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    for strom in (sys.stdout, sys.stderr):
        if hasattr(strom, "reconfigure"):
            strom.reconfigure(encoding="utf-8", errors="replace")
    if any(x in ("-h", "--help", "--hilfe") for x in argv) or argv[:1] == ["hilfe"]:
        sys.stdout.write(HILFE)
        return 0
    try:
        if not argv:
            raise Aufruffehler("Befehl fehlt (neu, pruefen, status)")
        befehl, rest = argv[0], argv[1:]
        if befehl == "neu":
            if not rest:
                raise Aufruffehler("kurzname fehlt: vorschlag neu <kurzname>")
            return cmd_neu(rest)
        if befehl == "pruefen":
            if len(rest) != 1:
                raise Aufruffehler("vorschlag pruefen <ordner>")
            return cmd_pruefen(rest[0])
        if befehl == "status":
            if rest:
                raise Aufruffehler("vorschlag status erwartet keine weiteren Angaben")
            return cmd_status()
        raise Aufruffehler(f"unbekannter Befehl {befehl!r} (möglich: neu, pruefen, status)")
    except Aufruffehler as e:
        print(f"Falscher Aufruf: {e}. Hilfe: vorschlag -h", file=sys.stderr)
        return EXIT_AUFRUF
    except Fehler as e:
        print(f"Fehler: {e}", file=sys.stderr)
        return EXIT_FEHLER
    except OSError as e:
        print(f"Fehler: {e.filename or ''} {e.strerror}".strip(), file=sys.stderr)
        return EXIT_FEHLER
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
